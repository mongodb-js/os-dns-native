{
  "name": "os-dns-native",
  "version": "2.0.1",
  "description": "Perform DNS queries using OS APIs",
  "main": "index.js",
  "scripts": {
    "pretest": "npm run build",
    "test": "mocha",
    "eslint": "eslint",
    "prettier": "prettier",
    "lint": "npm run eslint . && npm run prettier -- --check .",
    "reformat": "npm run eslint . -- --fix && npm run prettier -- --write .",
    "install": "node-gyp rebuild",
    "prepack": "npm run build",
    "build": "gen-esm-wrapper . ./.esm-wrapper.mjs",
    "prepublishOnly": "npm run build",
    "bump-packages": "bump-monorepo-packages"
  },
  "author": "Anna Henningsen <anna@addaleax.net>",
  "gypfile": true,
  "dependencies": {
    "debug": "^4.4.3",
    "ipv6-normalize": "^1.0.1",
    "node-addon-api": "^8.9.2"
  },
  "license": "MIT",
  "exports": {
    "require": "./index.js",
    "import": "./.esm-wrapper.mjs"
  },
  "homepage": "https://github.com/mongodb-js/os-dns-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mongodb-js/os-dns-native.git"
  },
  "bugs": "https://github.com/mongodb-js/os-dns-native/issues",
  "typings": "index.d.ts",
  "files": [
    "binding.cc",
    "binding.gyp",
    "index.d.ts",
    "index.js",
    "LICENSE",
    ".esm-wrapper.mjs"
  ],
  "devDependencies": {
    "@mongodb-js/eslint-config-devtools": "^0.11.12",
    "@mongodb-js/mocha-config-devtools": "^2.0.1",
    "@mongodb-js/monorepo-tools": "^1.6.0",
    "@mongodb-js/prettier-config-devtools": "^1.0.6",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "eslint": "^8.57.1",
    "gen-esm-wrapper": "^1.1.3",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
